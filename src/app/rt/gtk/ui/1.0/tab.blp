using Gtk 4.0;

template $WaspTab: Box {
  styles [
    "tab",
  ]

  orientation: vertical;
  hexpand: true;
  vexpand: true;
  title: bind $computed_title(
    template.config,
    split_tree.active-surface as <$WaspSurface>.title,
    split_tree.active-surface as <$WaspSurface>.title-override,
    template.title-override,
    split_tree.is-zoomed,
    split_tree.active-surface as <$WaspSurface>.bell-ringing
    ) as <string>;
  tooltip: bind split_tree.active-surface as <$WaspSurface>.pwd;

  $WaspSplitTree split_tree {
    notify::active-surface => $notify_active_surface();
    notify::tree => $notify_tree();
  }
}

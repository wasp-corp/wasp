@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(_wasp_vt_libdir "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@")

# Shared library target
if(NOT TARGET wasp-vt::wasp-vt)
    add_library(wasp-vt::wasp-vt SHARED IMPORTED)

    if(WIN32)
        set(_wasp_vt_shared_location "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/@WASP_VT_REALNAME@")
    else()
        set(_wasp_vt_shared_location "${_wasp_vt_libdir}/@WASP_VT_REALNAME@")
    endif()

    set_target_properties(wasp-vt::wasp-vt PROPERTIES
        IMPORTED_LOCATION "${_wasp_vt_shared_location}"
        INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
    )
    unset(_wasp_vt_shared_location)

    if(APPLE)
        set_target_properties(wasp-vt::wasp-vt PROPERTIES
            IMPORTED_SONAME "@rpath/@WASP_VT_SONAME@"
            INTERFACE_LINK_DIRECTORIES "${_wasp_vt_libdir}"
        )
        # Ensure consumers can find the @rpath dylib at runtime
        set_property(TARGET wasp-vt::wasp-vt APPEND PROPERTY
            INTERFACE_LINK_OPTIONS "LINKER:-rpath,${_wasp_vt_libdir}"
        )
    elseif(WIN32)
        set_target_properties(wasp-vt::wasp-vt PROPERTIES
            IMPORTED_IMPLIB "${_wasp_vt_libdir}/@WASP_VT_IMPLIB@"
        )
    else()
        set_target_properties(wasp-vt::wasp-vt PROPERTIES
            IMPORTED_SONAME "@WASP_VT_SONAME@"
        )
    endif()
endif()

# Static library target
#
# Consumers must link transitive dependencies themselves. By default (with
# SIMD enabled): libc, libc++ (or libstdc++ on Linux), highway, and
# simdutf. Building with -Dsimd=false removes the C++ / highway / simdutf
# dependencies.
if(NOT TARGET wasp-vt::wasp-vt-static)
    add_library(wasp-vt::wasp-vt-static STATIC IMPORTED)

    set_target_properties(wasp-vt::wasp-vt-static PROPERTIES
        IMPORTED_LOCATION "${_wasp_vt_libdir}/@WASP_VT_STATIC_REALNAME@"
        INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
    )
    if(WIN32)
        set_target_properties(wasp-vt::wasp-vt-static PROPERTIES
            INTERFACE_LINK_LIBRARIES "ntdll;kernel32"
        )
    endif()
endif()

unset(_wasp_vt_libdir)

check_required_components(wasp-vt)
